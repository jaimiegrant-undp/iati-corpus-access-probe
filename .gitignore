# --- Secrets ---
.env
.env.local
.env.*.local

# --- Transient caches (the retention boundary: NONE of this is a deliverable) ---
# Drawn document-link sample (re-drawable from the Datastore with the seed)
cache/sample/
# Computed readability metric cache (analysis re-runs from here without re-crawling)
cache/metrics/
# Transient fetched document BYTES — measured then discarded, never retained
cache/docbytes/
# Any raw extracted document text — transient working data only, never committed
cache/extracted_text/
# Catch-all: everything under cache/ is transient and clearable
cache/*
!cache/.gitkeep

# --- Committed output is the deliverable: findings tables + verdict ---
# output/ is intentionally NOT ignored. Keep its placeholder until files exist.
!output/
!output/.gitkeep

# --- Python artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- OS / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
