# Copy this file to .env.local and fill in the value.
# .env.local is gitignored and must NEVER be committed.

# IATI Datastore v3 API subscription key.
# Free. Obtain from the IATI Developer Portal. Sent as the
# `Ocp-Apim-Subscription-Key` request header by the Datastore wrapper.
# Required only for the LIVE sample draw (deliverable 2, live half).
# Deliverables 1-5 are built and tested offline against fixtures and do
# not need this key.
IATI_API_KEY=

# --- Not used yet ---
# An OCR API key would be added here ONLY if Decisions Log Q3 is resolved
# to option (b) or (c) (sub-sample or full OCR). Until that stop-and-ask
# is settled, no OCR dependency and no OCR key exist.
# OCR_API_KEY=
